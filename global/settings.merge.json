      "PowerShell(node --print:*)",
      "PowerShell(python -c:*)",
      "PowerShell(python3 -c:*)",
      "PowerShell(py -c:*)",
      "PowerShell(bash -c:*)",
      "PowerShell(sh -c:*)",
      "PowerShell(powershell:*)",
      "PowerShell(powershell.exe:*)",
      "PowerShell(pwsh:*)",
