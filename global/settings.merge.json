      "PowerShell(npx:*)",
      "PowerShell(pnpm dlx:*)",
      "PowerShell(yarn dlx:*)",
      "PowerShell(uvx:*)",
      "PowerShell(pip install:*)",
      "PowerShell(pip3 install:*)",
      "PowerShell(python -m pip install:*)",
      "PowerShell(py -m pip install:*)",
      "PowerShell(dotnet add package:*)",
      "PowerShell(dotnet tool install:*)",
      "PowerShell(winget:*)",
