{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "advisorModel": "opus",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "ponytail@ponytail": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/bloquear-segredos.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(**/*.env)",
      "Read(**/*.pfx)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.kdbx)",
      "Read(**/*.vault)",
      "Read(**/secrets.json)",
      "Read(**/*secrets*.json)",
      "Read(**/*secrets*.yaml)",
      "Read(**/*secrets*.yml)",
      "Read(**/secrets/**)",
      "Read(**/appsettings.*.json)",
      "Read(**/local.settings.json)",
      "Read(**/.credentials.json)",
      "Read(**/.git-credentials)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/.pgpass)",
      "Read(**/.pypirc)",
      "Read(**/*.ppk)",
      "Read(**/.ssh/**)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/.aws/**)",
      "Read(**/.azure/**)",
      "Read(**/.kube/config)",
      "Read(**/.docker/config.json)",
      "Read(**/.claude.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)",
      "Read(~/.pypirc)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/**)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Edit(~/.claude/settings*.json)",
      "Write(~/.claude/settings*.json)",
      "Edit(~/.claude/hooks/**)",
      "Write(~/.claude/hooks/**)"
    ],
    "ask": [
      "Read(**/web.config)",
      "Edit(**/.claude/settings*.json)",
      "Write(**/.claude/settings*.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Write(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/skills/**)",
      "Write(~/.claude/skills/**)",
      "Edit(~/.claude/agents/**)",
      "Write(~/.claude/agents/**)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm exec:*)",
      "Bash(npx:*)",
      "Bash(pnpm dlx:*)",
      "Bash(yarn dlx:*)",
      "Bash(uvx:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(python -m pip install:*)",
      "Bash(py -m pip install:*)",
      "Bash(dotnet add package:*)",
      "Bash(dotnet tool install:*)",
      "Bash(winget:*)",
      "Bash(gh api:*)",
      "Bash(gh gist:*)",
      "Bash(gh secret:*)",
      "Bash(gh release:*)",
      "Bash(gh repo create:*)",
      "Bash(rm:*)",
      "Bash(node -e:*)",
      "Bash(node --eval:*)",
      "Bash(node -p:*)",
      "Bash(node --print:*)",
      "Bash(python -c:*)",
