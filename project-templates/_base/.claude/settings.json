{
  "extraKnownMarketplaces": {
    "kit-dev-ia": { "source": { "source": "github", "repo": "LeonardoPokrewecky/claude-code-setup" } }
  },
  "enabledPlugins": {
    "base@kit-dev-ia": true
  },
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/.angular/**)",
      "Read(**/bin/**)",
      "Read(**/obj/**)",
      "Read(**/.vs/**)",
      "Read(**/*.min.js)"
    ]
  }
}
